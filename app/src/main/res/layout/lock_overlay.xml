<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    tools:ignore="Overdraw"> <!-- Deep premium dark slate background -->

    <LinearLayout
        android:id="@+id/cardLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="28dp"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- Brand Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brandIconImage"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/limitra_brand_icon"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/appTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/app_name"
                android:textColor="#2EC4B6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <!-- Circular App Icon Container -->
        <FrameLayout
            android:id="@+id/emojiContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/emoji_container_bg"
            android:padding="12dp">

            <ImageView
                android:id="@+id/emojiImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/overlay_restricted_app"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/emojiText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="28sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/targetAppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Status Message -->
        <TextView
            android:id="@+id/limitOverText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/overlay_limit_over"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <!-- Divider Line before Quote -->
        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#334155" />

        <!-- Quote Section (Main Focal Point) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/quoteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:id="@+id/quoteAuthorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#2E3A4E" />

        <!-- Guide Footer -->
        <TextView
            android:id="@+id/returnToHomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/overlay_return_to_home"
            android:textColor="#475569"
            android:textSize="11sp"
            android:letterSpacing="0.02" />

        <!-- Tek çıkış yolu: kilit ekranı yalnızca bu butonla kalkar -->
        <TextView
            android:id="@+id/returnHomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="15dp"
            android:text="@string/overlay_return_home_button"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

    </LinearLayout>
</FrameLayout>
