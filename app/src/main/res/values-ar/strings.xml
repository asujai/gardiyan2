    <string name="settings_quote_dialog_desc">أضف اقتباسًا فلسفيًا أو تحفيزيًا خاصًا بك ليظهر عند بلوغ حد استخدام التطبيق.</string>
    <string name="settings_quote_text_label">نص الاقتباس</string>
