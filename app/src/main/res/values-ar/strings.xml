    <string name="settings_quote_pref_label">تفضيل العرض</string>
    <string name="settings_quote_pref_always">عرض اقتباسي دائمًا</string>
    <string name="settings_quote_pref_mix">مزج اقتباسي مع الاقتباسات الافتراضية</string>
