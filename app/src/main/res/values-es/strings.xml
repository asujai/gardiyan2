<resources>
    <string name="app_name">Limitra</string>
    <string name="accessibility_service_description">Limitra utiliza este permiso únicamente para detectar cuándo se abre una aplicación restringida, con el fin de aplicar sus límites de tiempo y límites digitales. Todos los datos se procesan localmente en su dispositivo; no se recopila ni exporta ningún dato. El seguimiento en segundo plano es únicamente para ejecutar las reglas de bloqueo que elija.</string>
    <string name="notification_channel_service">Servicio de Protección de Limitra</string>
    <string name="notification_channel_service_desc">Funciona para mantener activa la protección y aplicar localmente los límites que establezca. Sus datos permanecen completamente en su dispositivo.</string>
    <string name="overlay_limit_over">Has alcanzado tu límite diario hoy.</string>
    <string name="overlay_protected_by_gardiyan">Limitra mantiene esta aplicación bajo protección.</string>
    <string name="overlay_return_to_home">Vuelva a la pantalla de inicio para continuar.</string>
    <string name="overlay_explanation">Esta pantalla se muestra para proteger el límite que ha establecido.</string>
    <string name="perm_usage_access_title">Acceso de Uso</string>
    <string name="perm_usage_access_desc">Requerido para calcular localmente cuánto tiempo pasa en las aplicaciones seleccionadas y verificar los límites.</string>
    <string name="perm_accessibility_title">Servicio de Accesibilidad</string>
    <string name="perm_accessibility_desc">Se utiliza para detectar instantáneamente cuándo se abre una aplicación restringida y aplicar los límites digitales establecidos.</string>
    <string name="perm_overlay_title">Mostrar sobre otras aplicaciones</string>
    <string name="perm_overlay_desc">Requerido para mostrar la pantalla de protección sobre la aplicación cuando se alcance su límite diario.</string>
    <string name="perm_battery_title">Exención de Optimización de Batería</string>
    <string name="perm_battery_desc">Requerido para que el motor de protección de Limitra funcione de manera segura en segundo plano sin ser cancelado por el sistema.</string>
    <string name="perm_notification_title">Permiso de Notificación</string>
    <string name="perm_notification_desc">Se utiliza para mostrar una notification de estado persistente que indica que el motor de protección está actualmente activo y funcionando.</string>
    <string name="disclosure_overlay_title">Permiso de Pantalla de Bloqueo Requerido</string>
    <string name="disclosure_overlay_desc">La aplicación Limitra utiliza el permiso de \"Mostrar sobre otras aplicaciones\" para detenerlo cuando intenta abrir aplicaciones bloqueadas durante su tiempo de enfoque y mostrar una \"Pantalla de bloqueo\" (escudo). Este permiso solo es necesario para mantenerlo en la pantalla de bloqueo.</string>
    <string name="disclosure_accessibility_title">Servicio de Accesibilidad Requerido</string>
    <string name="disclosure_accessibility_desc">La aplicación Limitra utiliza la API del Servicio de Accesibilidad para detectar qué aplicación abre durante sus sesiones de enfoque y cerrarla instantáneamente si se abre una aplicación bloqueada.\n\nIMPORTANTE: Este servicio monitorea las interacciones de pantalla en su dispositivo pero no recopila, guarda ni comparte ninguno de sus datos personales o confidenciales (contraseñas, mensajes, etc.) con terceros.</string>
    <string name="btn_accept_disclosure">Entiendo y Acepto</string>
    <string name="btn_deny_disclosure">Rechazar</string>
    <string name="disclosure_battery_title">Protección Ininterrumpida</string>
    <string name="disclosure_battery_desc">Para garantizar que la aplicación Limitra funcione sin problemas en segundo plano, sus sesiones de enfoque no se interrumpan y el sistema no detenga los bloqueos, se deben eliminar las restricciones de optimización de la batería.</string>
