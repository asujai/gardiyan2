    <string name="perm_usage_access_title">Usage Access</string>
    <string name="perm_usage_access_desc">Required to locally calculate how much time you spend on selected apps and check limits.</string>
    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Used to instantly detect when a restricted app is opened and enforce your set digital boundaries.</string>
    <string name="perm_overlay_title">Display Over Other Apps</string>
    <string name="perm_overlay_desc">Required to display the protection screen over the app when your daily limit is reached.</string>
    <string name="perm_battery_title">Battery Optimization Exemption</string>
    <string name="perm_battery_desc">Required for the Limitra protection engine to run safely in the background without being terminated by the system.</string>
    <string name="perm_notification_title">Notification Permission</string>
    <string name="perm_notification_desc">Used to display a persistent status notification showing that the protection engine is currently active and running.</string>
    <string name="disclosure_overlay_title">Lock Screen Permission Required</string>
    <string name="disclosure_overlay_desc">The Limitra app uses the \"Display Over Other Apps\" permission to stop you when trying to open blocked apps during your focus time and show a \"Lock Screen\" (shield). This permission is only required to keep you on the block screen.</string>
    <string name="disclosure_accessibility_title">Accessibility Service Required</string>
    <string name="disclosure_accessibility_desc">The Limitra app uses the Accessibility Service API to detect which app you open during your focus sessions and instantly close it if a blocked app is opened.\n\nIMPORTANT: This service monitors screen interactions on your device but does not collect, save, or share any of your personal or sensitive data (passwords, messages, etc.) with third parties.</string>
