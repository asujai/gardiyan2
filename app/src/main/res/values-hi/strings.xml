<resources>
    <string name="app_name">Limitra</string>
    <string name="accessibility_service_description">Limitra इस अनुमति का उपयोग केवल तब करता है जब कोई प्रतिबंधित ऐप खोला जाता है, ताकि आपकी डिजिटल सीमाओं और ऐप सीमाओं को लागू किया जा सके। सभी डेटा आपके डिवाइस पर स्थानीय रूप से संसाधित किया जाता है; कोई भी डेटा एकत्र या निर्यात नहीं किया जाता है। बैकग्राउंड ट्रैकिंग केवल आपके द्वारा चुने गए ब्लॉक नियमों को निष्पादित करने के लिए है।</string>
    <string name="notification_channel_service">Limitra सुरक्षा सेवा</string>
    <string name="notification_channel_service_desc">सुरक्षा को सक्रिय रखने और आपके द्वारा निर्धारित सीमाओं को स्थानीय रूप से लागू करने के लिए काम करता है। आपका डेटा पूरी तरह से आपके डिवाइस पर रहता है।</string>
    <string name="overlay_limit_over">आज के लिए आपकी सीमा समाप्त हो गई है।</string>
    <string name="overlay_protected_by_gardiyan">Limitra इस ऐप को सुरक्षा के अधीन रखता है।</string>
    <string name="overlay_return_to_home">जारी रखने के लिए होम स्क्रीन पर वापस जाएं।</string>
    <string name="overlay_explanation">यह स्क्रीन आपके द्वारा निर्धारित सीमा की सुरक्षा के लिए दिखाई जा रही है।</string>
    <string name="perm_usage_access_title">उपयोग पहुंच</string>
    <string name="perm_usage_access_desc">चयनित ऐप्स पर आपके द्वारा बिताए गए समय की स्थानीय रूप से गणना करने और सीमाओं की जांच करने के लिए आवश्यक है।</string>
    <string name="perm_accessibility_title">अभिगम्यता सेवा</string>
    <string name="perm_accessibility_desc">प्रतिबंधित ऐप खुलने पर तुरंत पता लगाने और आपके द्वारा निर्धारित डिजिटल सीमाओं को लागू करने के लिए उपयोग किया जाता. है।</string>
    <string name="perm_overlay_title">अन्य ऐप्स के ऊपर प्रदर्शित करें</string>
    <string name="perm_overlay_desc">दैनिक सीमा समाप्त होने पर ऐप के ऊपर सुरक्षा स्क्रीन प्रदर्शित करने के लिए आवश्यक है।</string>
    <string name="perm_battery_title">बैटरी अनुकूलन से छूट</string>
    <string name="perm_battery_desc">Limitra सुरक्षा इंजन को सिस्टम द्वारा बंद किए बिना पृष्ठभूमि में सुरक्षित रूप से चलाने के लिए आवश्यक है।</string>
    <string name="perm_notification_title">अधिसूचना अनुमति</string>
    <string name="perm_notification_desc">एक निरंतर स्थिति अधिसूचना प्रदर्शित करने के लिए उपयोग किया जाता है जो दिखाती है कि सुरक्षा इंजन वर्तमान में सक्रिय है और चल रहा है।</string>
    <string name="disclosure_overlay_title">लॉक स्क्रीन अनुमति आवश्यक</string>
    <string name="disclosure_overlay_desc">जब आप अपने फोकस समय के दौरान ब्लॉक किए गए ऐप्स को खोलने का प्रयास करते हैं तो Limitra ऐप आपको रोकने और स्क्रीन पर एक \"लॉक स्क्रीन\" (ढाल) दिखाने के लिए \"अन्य ऐप्स के ऊपर प्रदर्शित करें\" अनुमति का उपयोग करता है। यह अनुमति केवल आपको ब्लॉक स्क्रीन पर रखने के लिए आवश्यक है।</string>
    <string name="disclosure_accessibility_title">अभिगम्यता सेवा आवश्यक</string>
    <string name="disclosure_accessibility_desc">Limitra ऐप आपके फोकस सत्रों के दौरान आपके द्वारा खोले जाने वाले ऐप का पता लगाने और ब्लॉक किए गए ऐप के खुलने पर उसे तुरंत बंद करने के लिए अभिगम्यता सेवा एपीआई (Accessibility Service API) का उपयोग करता है।\n\nमहत्वपूर्ण: यह सेवा आपके डिवाइस पर स्क्रीन इंटरैक्शन की निगरानी करती है लेकिन आपकी किसी भी व्यक्तिगत या संवेदनशील डेटा (पासवर्ड, संदेश आदि) को एकत्र, सहेज या तीसरे पक्षों के साथ साझा नहीं करती है।</string>
    <string name="btn_accept_disclosure">मैं समझता/समझती हूं और स्वीकार करता/करती हूं</string>
    <string name="btn_deny_disclosure">अस्वीकार करें</string>
    <string name="disclosure_battery_title">निर्बाध सुरक्षा</string>
    <string name="disclosure_battery_desc">यह सुनिश्चित करने के लिए कि Limitra ऐप पृष्ठभूमि में सुचारू रूप से चले, आपके फोकस सत्र बाधित न हों, और ब्लॉक सिस्टम द्वारा बंद न किए जाएं, बैटरी अनुकूलन प्रतिबंधों को हटाया जाना चाहिए।</string>
